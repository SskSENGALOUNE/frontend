# Copy to .env on the server and fill in. Never commit .env.

# Long random values: generate each with `openssl rand -hex 32`
DB_PASSWORD=
JWT_SECRET=

# ":80" = http://<server-ip>  |  later a domain, e.g. money.example.com (enables HTTPS automatically)
SITE_ADDRESS=:80

APP_TIMEZONE=Asia/Vientiane
JWT_EXPIRY_HOURS=72

# Where Caddy listens. Defaults: all interfaces, ports 80/443.
# If another web server (e.g. nginx) already owns 80/443, use BIND_ADDR=127.0.0.1 with free ports
# (HTTP_PORT=8088, HTTPS_PORT=8443) and let that web server proxy to http://127.0.0.1:8088.
BIND_ADDR=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# Set automatically by deploy/release.sh to the image version that is running
APP_TAG=
